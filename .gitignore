# Ignore rules shared by everything in this repository.
# Language- and tool-specific rules belong in each project's own .gitignore.

# Operating system
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs and temporary files
*.log
*.tmp
tmp/
